@page "/dashboard"
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "Admin,Manager")]

<PageTitle>Dashboard</PageTitle>

<h1>Dashboard</h1>

<div class="row mt-4">
    <div class="col-md-4">
        <div class="stats-card">
            <h3>Total Users</h3>
            <p class="stats-number">1,234</p>
        </div>
    </div>
    <div class="col-md-4">
        <div class="stats-card">
            <h3>Active Sessions</h3>
            <p class="stats-number">567</p>
        </div>
    </div>
    <div class="col-md-4">
        <div class="stats-card">
            <h3>Reports</h3>
            <p class="stats-number">89</p>
        </div>
    </div>
</div>

<div class="mt-4">
    <p class="alert alert-info">
        This page is accessible to <strong>Admin</strong> and <strong>Manager</strong> roles only.
    </p>
</div>
